# Credenciales de Mercado Pago (producción)
# Coloca tus valores reales en .env.local y en Vercel, nunca los pegues en el código.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxx

# Identificador entregado por el programa/certificación.
# El SDK de Node lo envía como encabezado X-Integrator-Id.
MERCADOPAGO_INTEGRATOR_ID=dev_tu_integrator_id

# URL pública HTTPS de tu web en producción, sin slash final.
NEXT_PUBLIC_BASE_URL=https://tu-dominio.com

# Opcional: clave secreta configurada para validar la firma del webhook
MERCADOPAGO_WEBHOOK_SECRET=
