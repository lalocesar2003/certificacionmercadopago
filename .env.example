# Credenciales de prueba (Mercado Pago > Tus integraciones > Credenciales)
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxxxxxxxxxx

# Identificador entregado por el programa/certificación
# El SDK de Node lo envía como encabezado X-Integrator-Id.
MERCADOPAGO_INTEGRATOR_ID=dev_24c65fb163bf11ea96500242ac130004

# Correo asociado a tu cuenta de Mercado Pago; se envía como external_reference.
MERCADOPAGO_ACCOUNT_EMAIL=tu-correo@ejemplo.com

# URL pública HTTPS durante las pruebas (por ejemplo, un túnel hacia localhost:3000)
NEXT_PUBLIC_BASE_URL=https://tu-dominio-publico.example

# Opcional: clave secreta configurada para validar la firma del webhook
MERCADOPAGO_WEBHOOK_SECRET=
